# Database Configuration
DATABASE_URL=postgresql+asyncpg://chunker:chunker_pass@localhost:5432/chunking_playground
CORS_ORIGINS=http://localhost,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10

# Qdrant Cloud Configuration
QDRANT_URL=https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=multimodal_rag_playground

# OpenRouter API Configuration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
