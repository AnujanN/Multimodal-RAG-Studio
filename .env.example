# Database Configuration
DATABASE_URL=postgresql+asyncpg://chunker:chunker_pass@localhost:5432/chunking_playground
CORS_ORIGINS=http://localhost,http://localhost:5173
MAX_UPLOAD_SIZE_MB=10

# Qdrant Cloud Configuration (Admin / .env defaults)
QDRANT_URL=https://your-cluster-id.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=multimodal_rag_playground

# OpenRouter API Key for RAG Answer Generation (Admin default)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Auth & Security
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please-change-this-to-a-random-64char-secret-in-production

# Fernet encryption key for user API key storage
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Admin Email List (comma-separated — users matching these emails get automatic Admin access and use system .env keys)
ADMIN_EMAILS=your.email@example.com

# Google OAuth (optional - leave blank to disable Google login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
